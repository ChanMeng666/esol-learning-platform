# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# CopilotKit Configuration
NEXT_PUBLIC_COPILOT_API_KEY=your_copilot_public_api_key_here

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=your_vercel_blob_read_write_token_here

# Neon Database Configuration
DATABASE_URL=your_neon_database_url_here
DATABASE_URL_UNPOOLED=your_neon_database_url_unpooled_here
NEON_PROJECT_ID=your_neon_project_id_here

# PostgreSQL Configuration (from Neon)
PGDATABASE=your_database_name
PGHOST=your_database_host_pooler
PGHOST_UNPOOLED=your_database_host_unpooled
PGPASSWORD=your_database_password
PGUSER=your_database_user
POSTGRES_DATABASE=your_database_name
POSTGRES_HOST=your_database_host_pooler
POSTGRES_PASSWORD=your_database_password
POSTGRES_PRISMA_URL=your_postgres_prisma_url_here
POSTGRES_URL=your_postgres_url_here
POSTGRES_URL_NON_POOLING=your_postgres_url_non_pooling_here
POSTGRES_URL_NO_SSL=your_postgres_url_no_ssl_here
POSTGRES_USER=your_database_user

# Stack Auth Configuration
NEXT_PUBLIC_STACK_PROJECT_ID=your_stack_project_id_here
NEXT_PUBLIC_STACK_PUBLISHABLE_CLIENT_KEY=your_stack_publishable_client_key_here
STACK_SECRET_SERVER_KEY=your_stack_secret_server_key_here

# Vercel OIDC Token (auto-generated by Vercel CLI)
VERCEL_OIDC_TOKEN=your_vercel_oidc_token_here

# Note: Copy this file to .env.local and replace the values with your actual credentials
# Never commit .env.local to version control!
